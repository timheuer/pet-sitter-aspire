@page "/"

<PageTitle>PetStay - Airbnb for Pets</PageTitle>

<div class="hero-section text-center py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3">
            <span class="bi bi-heart-fill text-danger"></span> Welcome to PetStay
        </h1>
        <p class="lead fs-3 mb-4">The Airbnb for Pets - Find Trusted Pet Sitters Near You</p>
        <p class="fs-5 mb-4">Leave your furry friends in loving hands while you're away</p>
        <a href="/petsitters" class="btn btn-light btn-lg px-5 py-3 me-3">
            <span class="bi bi-search"></span> Find Pet Sitters
        </a>
        <a href="/becomesitter" class="btn btn-outline-light btn-lg px-5 py-3">
            <span class="bi bi-heart"></span> Become a Sitter
        </a>
    </div>
</div>

<div class="container mb-5">
    <h2 class="text-center mb-5">Why Choose PetStay?</h2>
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="display-4 text-primary mb-3">
                        <span class="bi bi-shield-check"></span>
                    </div>
                    <h3 class="h4 mb-3">Trusted Sitters</h3>
                    <p class="text-muted">All our pet sitters are verified and reviewed by the community. Read real reviews from pet owners.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="display-4 text-success mb-3">
                        <span class="bi bi-house-heart"></span>
                    </div>
                    <h3 class="h4 mb-3">Home Comfort</h3>
                    <p class="text-muted">Your pets stay in a loving home environment with personalized care and attention.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card h-100 text-center border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="display-4 text-info mb-3">
                        <span class="bi bi-currency-dollar"></span>
                    </div>
                    <h3 class="h4 mb-3">Affordable Pricing</h3>
                    <p class="text-muted">Find pet sitters that fit your budget. Transparent pricing with no hidden fees.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row align-items-center">
        <div class="col-md-6 mb-4">
            <h2 class="mb-4">How It Works</h2>
            <div class="d-flex mb-4">
                <div class="me-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" 
                         style="width: 50px; height: 50px; font-size: 1.5rem; font-weight: bold;">1</div>
                </div>
                <div>
                    <h4>Search Pet Sitters</h4>
                    <p class="text-muted">Browse profiles, read reviews, and find the perfect match for your pet.</p>
                </div>
            </div>
            <div class="d-flex mb-4">
                <div class="me-3">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" 
                         style="width: 50px; height: 50px; font-size: 1.5rem; font-weight: bold;">2</div>
                </div>
                <div>
                    <h4>Book Your Stay</h4>
                    <p class="text-muted">Select dates, provide details about your pet, and submit a booking request.</p>
                </div>
            </div>
            <div class="d-flex mb-4">
                <div class="me-3">
                    <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center" 
                         style="width: 50px; height: 50px; font-size: 1.5rem; font-weight: bold;">3</div>
                </div>
                <div>
                    <h4>Enjoy Peace of Mind</h4>
                    <p class="text-muted">Relax knowing your pet is in good hands. Get updates and photos during their stay.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <img src="https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=600&h=400&fit=crop" 
                 class="img-fluid rounded shadow" alt="Happy pets" />
        </div>
    </div>
</div>

<div class="bg-light py-5">
    <div class="container text-center">
        <h2 class="mb-4">Want to Become a Pet Sitter?</h2>
        <p class="lead mb-4">Join our community of pet lovers and earn money while caring for adorable pets!</p>
        <a href="/becomesitter" class="btn btn-primary btn-lg px-5 py-3">
            <span class="bi bi-heart-fill"></span> Get Started Today
        </a>
    </div>
</div>
