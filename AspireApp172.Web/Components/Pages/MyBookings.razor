@page "/mybookings"
@using AspireApp172.ApiService.Models
@using AspireApp172.Web.Services
@inject PetSitterApiClient ApiClient
@rendermode InteractiveServer

<PageTitle>My Bookings</PageTitle>

<div class="container py-4">
    <h1 class="display-5 mb-4">
        <span class="bi bi-calendar-check-fill text-primary"></span> My Bookings
    </h1>

    @if (bookings == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading your bookings...</p>
        </div>
    }
    else if (!bookings.Any())
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <span class="bi bi-calendar-x display-1 text-muted"></span>
            </div>
            <h3>No bookings yet</h3>
            <p class="text-muted mb-4">Start by finding the perfect pet sitter for your furry friend!</p>
            <a href="/petsitters" class="btn btn-primary btn-lg">
                <span class="bi bi-search"></span> Find Pet Sitters
            </a>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Total Bookings</h5>
                        <h2 class="text-primary">@bookings.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Pending</h5>
                        <h2 class="text-warning">@bookings.Count(b => b.Status == BookingStatus.Pending)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Confirmed</h5>
                        <h2 class="text-success">@bookings.Count(b => b.Status == BookingStatus.Confirmed)</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="text-muted">Completed</h5>
                        <h2 class="text-info">@bookings.Count(b => b.Status == BookingStatus.Completed)</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var booking in bookings.OrderByDescending(b => b.CreatedAt))
            {
                var sitter = petSitters?.FirstOrDefault(s => s.Id == booking.PetSitterId);
                var statusClass = booking.Status switch
                {
                    BookingStatus.Pending => "warning",
                    BookingStatus.Confirmed => "success",
                    BookingStatus.Cancelled => "danger",
                    BookingStatus.Completed => "info",
                    _ => "secondary"
                };

                <div class="col-12 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    @if (sitter?.ImageUrl != null)
                                    {
                                        <img src="@sitter.ImageUrl" class="img-fluid rounded-circle" alt="@sitter.Name" style="width: 80px; height: 80px; object-fit: cover;">
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h5 class="mb-1">@(sitter?.Name ?? "Pet Sitter")</h5>
                                    <p class="text-muted mb-1">
                                        <span class="bi bi-geo-alt-fill"></span> @(sitter?.Location ?? "Unknown")
                                    </p>
                                    <span class="badge bg-@statusClass">@booking.Status</span>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-2">
                                        <small class="text-muted">Check-in</small><br />
                                        <strong>@booking.CheckInDate.ToString("MMM dd, yyyy")</strong>
                                    </div>
                                    <div>
                                        <small class="text-muted">Check-out</small><br />
                                        <strong>@booking.CheckOutDate.ToString("MMM dd, yyyy")</strong>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <h4 class="text-primary mb-0">$@booking.TotalPrice.ToString("F2")</h4>
                                    <small class="text-muted">@((booking.CheckOutDate - booking.CheckInDate).Days) nights</small>
                                </div>
                                <div class="col-md-1">
                                    @if (booking.Status == BookingStatus.Pending)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelBooking(booking.Id)">
                                            Cancel
                                        </button>
                                    }
                                    @if (booking.Status == BookingStatus.Completed && !hasReview.Contains(booking.Id))
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => ShowReviewForm(booking.Id)">
                                            Review
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(booking.SpecialRequests))
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <small class="text-muted">Special Requests:</small>
                                    <p class="mb-0">@booking.SpecialRequests</p>
                                </div>
                            }
                            @if (showReviewForm && reviewBookingId == booking.Id)
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <h6>Leave a Review</h6>
                                    <div class="mb-3">
                                        <label class="form-label">Rating</label>
                                        <select class="form-select" @bind="newReview.Rating">
                                            <option value="5">5 Stars - Excellent</option>
                                            <option value="4">4 Stars - Very Good</option>
                                            <option value="3">3 Stars - Good</option>
                                            <option value="2">2 Stars - Fair</option>
                                            <option value="1">1 Star - Poor</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Your Review</label>
                                        <textarea class="form-control" rows="3" @bind="newReview.Comment"></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Your Name</label>
                                        <input type="text" class="form-control" @bind="newReview.ReviewerName" />
                                    </div>
                                    <button class="btn btn-primary me-2" @onclick="() => SubmitReview(booking.Id, booking.PetSitterId)">
                                        Submit Review
                                    </button>
                                    <button class="btn btn-secondary" @onclick="() => showReviewForm = false">
                                        Cancel
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Booking>? bookings;
    private List<PetSitter>? petSitters;
    private bool showReviewForm = false;
    private int reviewBookingId = 0;
    private HashSet<int> hasReview = new();

    private Review newReview = new()
    {
        ReviewerName = "",
        Comment = "",
        Rating = 5
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        bookings = await ApiClient.GetBookingsAsync();
        petSitters = await ApiClient.GetPetSittersAsync();
    }

    private async Task CancelBooking(int bookingId)
    {
        var booking = bookings?.FirstOrDefault(b => b.Id == bookingId);
        if (booking != null)
        {
            booking.Status = BookingStatus.Cancelled;
            await ApiClient.UpdateBookingAsync(bookingId, booking);
            await LoadData();
        }
    }

    private void ShowReviewForm(int bookingId)
    {
        reviewBookingId = bookingId;
        showReviewForm = true;
        newReview = new()
        {
            ReviewerName = "",
            Comment = "",
            Rating = 5
        };
    }

    private async Task SubmitReview(int bookingId, int petSitterId)
    {
        if (string.IsNullOrWhiteSpace(newReview.ReviewerName) || string.IsNullOrWhiteSpace(newReview.Comment))
        {
            return;
        }

        newReview.BookingId = bookingId;
        newReview.PetSitterId = petSitterId;

        await ApiClient.CreateReviewAsync(newReview);
        hasReview.Add(bookingId);
        showReviewForm = false;
        await LoadData();
    }
}
